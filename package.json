{
  "name": "urlcita-api",
  "version": "1.0.0",
  "description": "Backend of a URL shortener.",
  "license": "MIT",
  "author": "Lautaro De Filippo",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,yaml --exec tsx src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "prisma:migrate:dev": "prisma migrate dev && prisma generate",
    "prisma:migrate:deploy": "dotenv -e .env.production prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:integration": "dotenv -e .env.test -- vitest --no-file-parallelism tests/integration",
    "test:reset-db": "dotenv -e .env.test prisma migrate reset --force",
    "prisma:migrate:test": "dotenv -e .env.test prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
