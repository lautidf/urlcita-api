generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id String @id @default(cuid())

	originalUrl String
	shortCode String @unique
  creatorId String

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())

  email String @unique
  passwordHash String
  name String

  links Link[]
  
  createdAt DateTime @default(now())
}